# Copy to .env for local use. Never commit the real file.
DATABASE_URL=sqlite:///./runtime/gympulse.db
API_BASE_URL=http://127.0.0.1:8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
APP_WRITE_TOKEN=
MAINTENANCE_TOKEN=
MAINTENANCE_MODE=false
CHECK_INTERVAL_SECONDS=300
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=
RENDER_DATABASE_ID=
RENDER_REGION=frankfurt
RENDER_POSTGRES_VERSION=16
# Your controller computer's public IPv4 address, /32. No universal allowlist.
RENDER_CONTROLLER_CIDR=
MAINTENANCE_DIR=./runtime/maintenance
# Empty PostgreSQL 16 database, local and disposable; never your app database.
TRIAL_DATABASE_URL=
